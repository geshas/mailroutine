# ------------------------------------------------------------------
# MailRoutine Application
# ------------------------------------------------------------------

APP_URL=http://localhost:8080
HTTP_ADDR=0.0.0.0
HTTP_PORT=8080
TZ=UTC

# Optional: comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For
# header is trusted (used for login rate limiting). Leave empty if not proxied.
# TRUSTED_PROXIES=172.18.0.0/16

# ------------------------------------------------------------------
# Local Administrator
# ------------------------------------------------------------------

ADMIN_USERNAME=admin

# Argon2id PHC hash generated with:
# mailroutine hash-password
# Keep the single quotes around the value so "$" characters are preserved.
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------------
# Sessions
# ------------------------------------------------------------------

SESSION_IDLE_TIMEOUT=30m
SESSION_RENEWAL_THRESHOLD=5m

# 0 disables absolute timeout
SESSION_ABSOLUTE_TIMEOUT=0

# At least 32 characters. Generate with: mailroutine generate-secret
SESSION_SECRET=

# ------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (default: APP_URL + /api/accounts/google/callback)
# GOOGLE_REDIRECT_URL=

# ------------------------------------------------------------------
# Encryption
# ------------------------------------------------------------------

# Base64 of exactly 32 random bytes. Generate with: mailroutine generate-secret
# BACK THIS UP: without it stored Gmail tokens cannot be decrypted.
ENCRYPTION_KEY=

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------

DATABASE_PATH=/data/mailroutine.db

# ------------------------------------------------------------------
# Scheduler
# ------------------------------------------------------------------

SCHEDULER_INTERVAL=60s
DEFAULT_MAX_MESSAGES_PER_RUN=500
MAX_CONCURRENT_ROUTINES=2

# ------------------------------------------------------------------
# Gmail
# ------------------------------------------------------------------

GMAIL_BATCH_SIZE=100
GMAIL_REQUEST_TIMEOUT=30s

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=json

# Optional file path; leave empty for console only
LOG_FILE_PATH=

LOG_MAX_SIZE_MB=10
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true
